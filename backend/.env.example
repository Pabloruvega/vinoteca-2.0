# --- Base de datos ---
MONGO_URI=mongodb://localhost:27017/vinoteca

# --- Auth ---
JWT_SECRET=cambiame-en-produccion-por-un-valor-largo-y-aleatorio

# --- Servidor ---
PORT=5000
FRONTEND_URL=http://localhost:5173

# --- Admins que crea `npm run seed` ---
# Formato: nombre:email:password;nombre:email:password;...
ADMIN_USERS=admin:admin@vinoteca.local:admin123

# --- Email para "olvidé mi contraseña" (opcional) ---
# Si se dejan vacíos, el link de reset se imprime en la consola del backend.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
