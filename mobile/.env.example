# URL del backend que va a usar la app mobile.
#
# - En el simulador/emulador podés dejar localhost.
# - En un celular físico conectado por Wi-Fi, "localhost" apunta al propio
#   celular, no a tu computadora: poné la IP de tu compu en la red local
#   (Windows: "ipconfig" -> IPv4 Address; Mac/Linux: "ifconfig" o "ip a").
EXPO_PUBLIC_API_BASE=http://192.168.0.151:5000
